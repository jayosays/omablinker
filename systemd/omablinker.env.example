# Copy this to /etc/omablinker.env and uncomment what you want.
# install.sh does this for you on first install (and never overwrites it
# again, so your edits are safe across updates).

# Optional: also blink a real hardware LED in lockstep with the on-screen
# one. Find candidates with: ls /sys/class/leds/
#OMABLINKER_LED_DEVICE=/sys/class/leds/platform::mydrive/brightness

# Milliseconds of silence before the LED is considered idle. Keep this in
# sync with the bar widget's "Hold time after activity" setting if you want
# the physical and on-screen LEDs to match.
#OMABLINKER_IDLE_MS=120
