[Unit]
Description=omablinker block I/O activity monitor (eBPF)
Documentation=https://github.com/jayosays/omablinker
After=multi-user.target

[Service]
Type=simple
# Loading a BPF program onto the block tracepoints needs root.
ExecStart=/usr/local/bin/omablinker-bpfd
EnvironmentFile=-/etc/omablinker.env
Restart=on-failure
RestartSec=2
RuntimeDirectory=omablinker
RuntimeDirectoryMode=0755
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
